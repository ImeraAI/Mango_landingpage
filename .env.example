# Origin used for canonical URLs, og:url, sitemap and JSON-LD. No trailing slash.
# Production falls back to https://mangoaiusa.com when unset.
NEXT_PUBLIC_SITE_URL=

# Web3Forms form ID that receives demo-request submissions. Public by design —
# it identifies the form, not the account. Falls back to the production key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
