{
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://plumbingimera-production.up.railway.app"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://plumbingimera-production.up.railway.app/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://plumbingimera-production.up.railway.app/assets/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://plumbingimera-production.up.railway.app/images/:path*"
    }
  ]
}
